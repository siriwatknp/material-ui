      <Menu2Item>PDF document</Menu2Item>
      <Menu2Item>EPUB publication</Menu2Item>
      <Menu2Item>Markdown</Menu2Item>
    </Menu2Submenu>
  </Menu2Submenu>
  <Menu2Separator />
  <Menu2Item>Print</Menu2Item>
</Menu2>